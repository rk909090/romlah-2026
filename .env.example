# Salin jadi .env.local untuk pengembangan, dan setel sebagai variabel
# lingkungan di panel Hostinger untuk produksi.
#
# JANGAN isi berkas ini dengan nilai sungguhan — berkas ini ikut ter-commit.

# ── Basis data (wajib) ───────────────────────────────────────────────
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# ── Biteship (ongkir) ────────────────────────────────────────────────
# Tanpa kedua nilai ini, ongkir memakai tarif contoh dan halaman keranjang
# menampilkan peringatannya.
BITESHIP_API_KEY=
# ID area outlet asal, berupa STRING seperti IDNP6IDNC148IDND837IDZ12530.
# Cari dengan: node scripts/biteship-origin.mjs 12530
BITESHIP_ORIGIN_AREA_ID=
# Opsional; bawaan jne,sicepat,jnt,anteraja,pos,tiki,ninja. Kurir di luar
# akun Biteship sekadar tidak muncul di hasil.
BITESHIP_COURIERS=

# ── Midtrans (pembayaran) ────────────────────────────────────────────
# Tanpa server key, tombol "Bayar sekarang" nonaktif dan pesanan tetap bisa
# diselesaikan lewat WhatsApp.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
# "true" memakai app.midtrans.com (UANG SUNGGUHAN).
# Selain itu memakai app.sandbox.midtrans.com.
MIDTRANS_IS_PRODUCTION=false

# ── Pelacakan (analytics) ────────────────────────────────────────────
# SELURUHNYA OPSIONAL. Nilai bawaannya sudah tertanam di src/data/site.ts,
# disalin dari romlah.com yang sedang berjalan, dan memang publik — siapa pun
# bisa membacanya dari kode sumber halaman. Isi di sini hanya kalau ingin
# menimpanya, misalnya untuk situs uji coba.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Bawaan: nyala di produksi, mati di tempat lain.
#   off = matikan juga di produksi (misalnya selama situs masih diuji)
#   on  = nyalakan di luar produksi. HANYA untuk memeriksa pemasangan, dan
#         wajib dipasangkan dengan ID palsu di atas — kalau tidak, data uji
#         ikut masuk ke laporan yang sungguhan.
NEXT_PUBLIC_ANALYTICS=
